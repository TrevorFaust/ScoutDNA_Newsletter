# Old ScoutDNA-only Supabase (msfhp) — only for recover_issue.py one-time copy
OLD_SUPABASE_URL=https://msfhpjfhrtzmhxyjoldp.supabase.co
OLD_SUPABASE_SERVICE_ROLE_KEY=

# Supabase API — shared DraftDNA DB (paveh)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Direct Postgres (from DBeaver connection or Supabase → Database → Connection string URI)
# Same URI in DraftDNA + ScoutDNA .env when sharing one database
DATABASE_URL=postgresql://postgres.[ref]:[password]@[host]:6543/postgres?sslmode=require

# Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Resend (Phase 2 email — https://resend.com)
RESEND_API_KEY=re_...
NEWSLETTER_FROM_EMAIL=newsletter@yourdomain.com

# Reddit API (https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=ScoutDNA-All32/1.0 (contact: you@example.com)

# YouTube (optional — pip install -r pipeline/requirements-youtube.txt; needs ffmpeg)
WHISPER_MODEL=base
YOUTUBE_MAX_VIDEOS_PER_CHANNEL=5
# YOUTUBE_CMD_TIMEOUT_SEC=120
# YOUTUBE_SKIP_WHISPER=true
# Podcasts (data/podcasts_registry.csv)
PODCAST_MAX_EPISODES_PER_FEED=3
# PODCAST_TRANSCRIBE=true  # download MP3 + Whisper (slow); default uses RSS show notes

# Pipeline
NEWSLETTER_TIMEZONE=America/Los_Angeles
PIPELINE_ALERT_EMAIL=you@example.com

# Web (Next.js)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
